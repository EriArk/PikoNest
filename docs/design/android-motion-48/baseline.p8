pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function solid_box(x,y,w,h)
 if w<=0 or h<=0 then
  return false
 end
 if x>=128 or y>=128 then
  return false
 end
 if x<0 then w+=x x=0 end
 if y<0 then h+=y y=0 end
 if w<=0 or h<=0 then
  return false
 end
 w=min(w,128-x)
 h=min(h,128-y)
 local r=ceil(x+w)-1
 local b=ceil(y+h)-1
 for j=flr(y/8),flr(b/8) do
  for i=flr(x/8),flr(r/8) do
   if fget(mget(i,j),7) then
    return true
   end
  end
 end
 return false
end
function solid_at(x,y)
 x=flr(x/8) y=flr(y/8)
 if x<0 or y<0 or
  x>=16 or y>=16 then
  return false
 end
 return fget(mget(x,y),7)
end
-- a blank canvas / pikoos
function _draw()
 cls(1)
map(0,0,0,0,16,16)
print(solid_at(24,40),16,60,7)
print(solid_box(24,40,16,8),16,90,7)
end

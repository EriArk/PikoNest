pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- a blank canvas / pikoos
function _draw()
 cls(1)
 do
  -- animation: sx,sy,w,h,end_seconds
  local frames={
   {16,0,16,16,0x0.8ccc},
   {16,0,8,8,0x1.0ccc},
  }
  local elapsed=time()
  elapsed%=0x1.0ccc
  for i=1,#frames do
   local f=frames[i]
   if elapsed<f[5] or i==#frames then
    sspr(f[1],f[2],f[3],f[4],
     24,40)
    break
   end
  end
 end
 sspr(16,0,16,16,80,40)
 camera(24,8)
 map(0,0,16,80,8,4)
 camera()
 map(0,32,16,112,5,1)
 camera()
 do
  -- animation: sx,sy,w,h,end_seconds
  local frames={
   {16,0,16,16,0x0.8ccc},
   {16,0,8,8,0x1.0ccc},
  }
  local elapsed=time()
  elapsed%=0x1.0ccc
  for i=1,#frames do
   local f=frames[i]
   if elapsed<f[5] or i==#frames then
    sspr(f[1],f[2],f[3],f[4],
     56,16)
    break
   end
  end
 end
end

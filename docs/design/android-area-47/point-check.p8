pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function solid_at(x,y)
 x=flr(x/8) y=flr(y/8)
 if x<0 or y<0 or
  x>=16 or y>=16 then
  return false
 end
 return fget(mget(x,y),7)
end
assert(solid_at(32,40)==true,"point0")
assert(solid_at(39.999,47.999)==true,"point1")
assert(solid_at(31.999,40)==false,"point2")
assert(solid_at(40,40)==false,"point3")
assert(solid_at(32,39.999)==false,"point4")
assert(solid_at(32,48)==false,"point5")
assert(solid_at(16,24)==false,"point6")
assert(solid_at(0,0)==false,"point7")
assert(solid_at(-0.001,40)==false,"point8")
assert(solid_at(32,-0.001)==false,"point9")
assert(solid_at(127.999,127.999)==false,"point10")
assert(solid_at(128,40)==false,"point11")
assert(solid_at(32,128)==false,"point12")
assert(solid_at(1024,512)==false,"point13")
camera(40,32)
assert(solid_at(32,40)==true,"camera independent")
camera()
fset(17,64)
assert(solid_at(32,40)==false,"chosen bit 7 only")
fset(17,128)
assert(solid_at(32,40)==true,"runtime flag change")
fset(0,128)
assert(solid_at(0,0)==true,"tile zero follows flags")
assert(solid_at(-1,0)==false,"explicit outside despite flag zero")
function edge_at(x,y)
 x=flr(x/8) y=flr(y/8)
 if x<0 or y<0 or
  x>=16 or y>=16 then
  return true
 end
 return fget(mget(x,y),7)
end
assert(edge_at(-1,0)==true,"other boundary policy")
assert(edge_at(128,0)==true,"right boundary")
printh("tile-probe46:21 checks passed")
function _draw()
 cls(1)
 print("point checks: 21/21",8,40,11)
 print("edges / fractions / camera",8,56,7)
end

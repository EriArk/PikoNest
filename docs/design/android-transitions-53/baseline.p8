pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
x=64 y=64
function _update()
 if btnp(0) then x-=32 end
 if btnp(1) then x+=32 end
 if btnp(2) then y-=32 end
 if btnp(3) then y+=32 end
end
function _draw()
 cls(1)
 camera(flr(mid(0,(x),2*128-1)/128)*128,flr(mid(0,(y),2*128-1)/128)*128)
 rectfill(0,0,255,255,3)
 rectfill(128,0,255,127,2)
 rectfill(0,128,127,255,12)
 rectfill(128,128,255,255,4)
 for j=0,7 do
  for i=0,7 do
   spr(17,i*32+12,j*32+12)
  end
 end
 print("garden",8,24,7)
 print("pond",8,152,1)
 camera()
 print("d-pad: look around",4,4,7)
end

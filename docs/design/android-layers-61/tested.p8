version 43
__lua__
cx=0
function _update()
 if btnp(0) then cx-=16 end
 if btnp(1) then cx+=16 end
end
function _draw()
 cls(1)
 camera(cx,0)
 do
  local _bg_cx,_bg_cy=camera()
  local _bg_w=32
  local _bg_phase=flr(
   (((time()%_bg_w)*0)%_bg_w
   -(_bg_cx*0)%_bg_w)%_bg_w)
  if true then
   for _bg_dx=_bg_phase-_bg_w,127,_bg_w do
    sspr(0,0,32,24,_bg_dx,24)
   end
  end
  camera(_bg_cx,_bg_cy)
 end
 do
  local _bg_cx,_bg_cy=camera()
  local _bg_w=64
  local _bg_phase=flr(
   (((time()%_bg_w)*0)%_bg_w
   -(_bg_cx*0)%_bg_w)%_bg_w)
  if true then
   for _bg_dx=_bg_phase-_bg_w,127,_bg_w do
    sspr(64,24,64,24,_bg_dx,24)
   end
  end
  camera(_bg_cx,_bg_cy)
 end
 camera()
 print("d-pad: camera",4,4,7)
 print(cx,4,116,7)
end

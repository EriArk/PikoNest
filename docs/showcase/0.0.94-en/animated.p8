pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 game_bg=1
 game_goal=1
 game_count=3
 sprite1_sx=8
 sprite1_sy=0
 sprite1_w=8
 sprite1_h=8
 sprite1_x=8
 sprite1_y=8
 sprite1_movement=1
 sprite1_speed=4
 sprite1_rule=0
 sprite1_target=1
 sprite1_on=0
 sprite1_neighbor=-1
 sprite1_visible=1
 sprite1_animation=1
 sprite1_frames=1
 sprite1_f0_sx=8
 sprite1_f0_sy=0
 sprite1_f0_w=8
 sprite1_f0_h=8
 sprite1_f0_ticks=6
 sprite1_clock=0
 sprite1_active=0
 sprite2_sx=16
 sprite2_sy=0
 sprite2_w=8
 sprite2_h=8
 sprite2_x=72
 sprite2_y=8
 sprite2_movement=0
 sprite2_speed=1
 sprite2_rule=1
 sprite2_target=0
 sprite2_on=0
 sprite2_neighbor=-1
 sprite2_visible=1
 sprite3_sx=24
 sprite3_sy=0
 sprite3_w=8
 sprite3_h=8
 sprite3_x=72
 sprite3_y=56
 sprite3_movement=0
 sprite3_speed=1
 sprite3_rule=3
 sprite3_target=0
 sprite3_on=0
 sprite3_neighbor=-1
 sprite3_visible=1
 world_width=32
 world_height=16
 world_camera=1
 world_target=0
 world_x=0
 world_y=0
 world_tiles=1
 world_walls={[4]=true}
 game_music=0
 game_music_parts=3
 music(-1)
 sfx(-1,3)
 game_start_sfx=8
 game_win_sfx=9
 game_score=0
 game_result=0
 game_selected=0
 game_last0=btn(0)
 game_last1=btn(1)
 game_last2=btn(2)
 game_last3=btn(3)
 game_last4=btn(4)
 game_last5=btn(5)
 music(game_music,0,7)
 sfx(game_start_sfx,3)
end

function world_blocked(x,y,w,h)
 for ty=flr(y/8),flr((y+h-1)/8) do
  for tx=flr(x/8),flr((x+w-1)/8) do
   if world_walls[mget(tx,ty)] then return true end
  end
 end
 return false
end

function world_move(x,y,w,h,dx,dy)
 local sx=dx==0 and 0 or sgn(dx)
 local sy=dy==0 and 0 or sgn(dy)
 for step=1,max(abs(dx),abs(dy)) do
  local nx=mid(0,x+sx,world_width*8-w)
  local ny=mid(0,y+sy,world_height*8-h)
  if dx~=0 and world_blocked(nx+(dx>0 and w-1 or 0),y,1,h) then break end
  if dy~=0 and world_blocked(x,ny+(dy>0 and h-1 or 0),w,1) then break end
  x=nx y=ny
 end
 return x,y
end

function _update()
 local pressed0=btn(0) and not game_last0
 game_last0=btn(0)
 local pressed1=btn(1) and not game_last1
 game_last1=btn(1)
 local pressed2=btn(2) and not game_last2
 game_last2=btn(2)
 local pressed3=btn(3) and not game_last3
 game_last3=btn(3)
 local pressed4=btn(4) and not game_last4
 game_last4=btn(4)
 local pressed5=btn(5) and not game_last5
 game_last5=btn(5)
 if pressed5 then
  _init()
  return
 end
 if game_result~=0 then return end
 local game_event_sfx=-1
 local sprite1_oldx=sprite1_x
 local sprite1_oldy=sprite1_y
 if btn(0) then sprite1_x,sprite1_y=world_move(sprite1_x,sprite1_y,sprite1_w,sprite1_h,-sprite1_speed,0) end
 if btn(1) then sprite1_x,sprite1_y=world_move(sprite1_x,sprite1_y,sprite1_w,sprite1_h,sprite1_speed,0) end
 if btn(2) then sprite1_x,sprite1_y=world_move(sprite1_x,sprite1_y,sprite1_w,sprite1_h,0,-sprite1_speed) end
 if btn(3) then sprite1_x,sprite1_y=world_move(sprite1_x,sprite1_y,sprite1_w,sprite1_h,0,sprite1_speed) end
 if sprite1_x~=sprite1_oldx or sprite1_y~=sprite1_oldy then
  if sprite1_active==1 then sprite1_clock=(sprite1_clock+1)%6 end
  sprite1_active=1
 else
  sprite1_clock=0
  sprite1_active=0
 end
 if game_result==0 and sprite2_visible==1 and sprite1_visible==1 and sprite2_x<sprite1_x+8 and sprite1_x<sprite2_x+8 and sprite2_y<sprite1_y+8 and sprite1_y<sprite2_y+8 then
  sprite2_visible=0
  game_score+=1
 end
 if game_result==0 and sprite3_visible==1 and sprite1_visible==1 and sprite3_x<sprite1_x+8 and sprite1_x<sprite3_x+8 and sprite3_y<sprite1_y+8 and sprite1_y<sprite3_y+8 then
  game_result=2
 end
 if game_result==0 and game_score==1 then game_result=1 end
 if game_result~=0 then music(-1) end
 if game_event_sfx>=0 then sfx(game_event_sfx,3) end
 if game_result==1 then sfx(game_win_sfx,3) end
end

function _draw()
 cls(game_bg)
 camera(mid(0,sprite1_x+4-64,world_width*8-128),mid(0,sprite1_y+4-64,world_height*8-128))
 map(0,0,0,0,world_width,world_height)
 if sprite1_visible==1 then
  if sprite1_clock<6 then
   sspr(8,0,8,8,sprite1_x,sprite1_y)
  end
 end
 if sprite2_visible==1 then
  sspr(16,0,8,8,sprite2_x,sprite2_y)
 end
 if sprite3_visible==1 then
  sspr(24,0,8,8,sprite3_x,sprite3_y)
 end
 camera()
 print("collected "..game_score.."/1",2,2,7)
 if game_result~=0 then
  rectfill(14,48,113,76,1)
  rect(14,48,113,76,7)
  print(game_result==1 and "you win!" or "try again",44,54,10)
  print("x: restart",44,66,7)
 end
end

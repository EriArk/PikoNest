pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 game_bg=1
 game_goal=0
 game_count=3
 sprite1_sx=8
 sprite1_sy=0
 sprite1_w=8
 sprite1_h=8
 sprite1_x=32
 sprite1_y=8
 sprite1_movement=1
 sprite1_speed=4
 sprite1_rule=0
 sprite1_target=1
 sprite1_on=0
 sprite1_neighbor=-1
 sprite1_visible=1
 sprite2_sx=16
 sprite2_sy=0
 sprite2_w=8
 sprite2_h=8
 sprite2_x=8
 sprite2_y=80
 sprite2_movement=0
 sprite2_speed=1
 sprite2_rule=4
 sprite2_target=0
 sprite2_on=1
 sprite2_neighbor=-1
 sprite2_visible=1
 sprite3_sx=24
 sprite3_sy=0
 sprite3_w=8
 sprite3_h=8
 sprite3_x=72
 sprite3_y=8
 sprite3_movement=0
 sprite3_speed=1
 sprite3_rule=2
 sprite3_target=0
 sprite3_on=0
 sprite3_neighbor=-1
 sprite3_visible=1
 world_width=16
 world_height=16
 world_camera=0
 world_target=-1
 world_x=0
 world_y=0
 world_tiles=1
 world_walls={[4]=true}
 passage_count=2
 passage1_x=4
 passage1_y=1
 passage1_tile=4
 passage1_target=1
 passage1_on=1
 passage2_x=4
 passage2_y=2
 passage2_tile=4
 passage2_target=1
 passage2_on=1
 world_passages(true)
 game_score=0
 game_result=0
 game_selected=0
 game_last0=btn(0)
 game_last1=btn(1)
 game_last2=btn(2)
 game_last3=btn(3)
 game_last4=btn(4)
 game_last5=btn(5)
end

function world_blocked(x,y,w,h)
 for ty=flr(y/8),flr((y+h-1)/8) do
  for tx=flr(x/8),flr((x+w-1)/8) do
   if world_walls[mget(tx,ty)] then return true end
  end
 end
 return false
end

function world_move(x,y,w,h,dx,dy)
 local sx=dx==0 and 0 or sgn(dx)
 local sy=dy==0 and 0 or sgn(dy)
 for step=1,max(abs(dx),abs(dy)) do
  local nx=mid(0,x+sx,world_width*8-w)
  local ny=mid(0,y+sy,world_height*8-h)
  if dx~=0 and world_blocked(nx+(dx>0 and w-1 or 0),y,1,h) then break end
  if dy~=0 and world_blocked(x,ny+(dy>0 and h-1 or 0),w,1) then break end
  x=nx y=ny
 end
 return x,y
end

function world_occupied(x,y)
 if sprite1_visible==1 and sprite1_x<x+8 and x<sprite1_x+sprite1_w and sprite1_y<y+8 and y<sprite1_y+sprite1_h then return true end
 return false
end

function world_passages(reset)
 if sprite2_on==passage1_on then
  mset(passage1_x,passage1_y,0)
 elseif reset or not world_occupied(passage1_x*8,passage1_y*8) then
  mset(passage1_x,passage1_y,passage1_tile)
 end
 if sprite2_on==passage2_on then
  mset(passage2_x,passage2_y,0)
 elseif reset or not world_occupied(passage2_x*8,passage2_y*8) then
  mset(passage2_x,passage2_y,passage2_tile)
 end
end

function _update()
 local pressed0=btn(0) and not game_last0
 game_last0=btn(0)
 local pressed1=btn(1) and not game_last1
 game_last1=btn(1)
 local pressed2=btn(2) and not game_last2
 game_last2=btn(2)
 local pressed3=btn(3) and not game_last3
 game_last3=btn(3)
 local pressed4=btn(4) and not game_last4
 game_last4=btn(4)
 local pressed5=btn(5) and not game_last5
 game_last5=btn(5)
 if pressed5 then
  _init()
  return
 end
 if game_result~=0 then return end
 if pressed0 then game_selected=(game_selected+0)%1 end
 if pressed1 then game_selected=(game_selected+1)%1 end
 if btn(0) then sprite1_x,sprite1_y=world_move(sprite1_x,sprite1_y,sprite1_w,sprite1_h,-sprite1_speed,0) end
 if btn(1) then sprite1_x,sprite1_y=world_move(sprite1_x,sprite1_y,sprite1_w,sprite1_h,sprite1_speed,0) end
 if btn(2) then sprite1_x,sprite1_y=world_move(sprite1_x,sprite1_y,sprite1_w,sprite1_h,0,-sprite1_speed) end
 if btn(3) then sprite1_x,sprite1_y=world_move(sprite1_x,sprite1_y,sprite1_w,sprite1_h,0,sprite1_speed) end
 if pressed4 and game_selected==0 then sprite2_on=1-sprite2_on end
 world_passages(false)
 if game_result==0 and sprite3_visible==1 and sprite1_visible==1 and sprite3_x<sprite1_x+8 and sprite1_x<sprite3_x+8 and sprite3_y<sprite1_y+8 and sprite1_y<sprite3_y+8 then
  game_result=1
 end
end

function _draw()
 cls(game_bg)
 camera(world_x,world_y)
 map(0,0,0,0,world_width,world_height)
 if sprite1_visible==1 then
  sspr(8,0,8,8,sprite1_x,sprite1_y)
 end
 if sprite2_visible==1 then
  sspr(16,0,8,8,sprite2_x,sprite2_y)
  rect(sprite2_x,sprite2_y,sprite2_x+7,sprite2_y+7,sprite2_on==1 and 11 or 5)
  if game_selected==0 then rect(sprite2_x-2,sprite2_y-2,sprite2_x+9,sprite2_y+9,10) end
 end
 if sprite3_visible==1 then
  sspr(24,0,8,8,sprite3_x,sprite3_y)
 end
 camera()
 print("left/right: select  o: toggle",2,118,7)
 if game_result~=0 then
  rectfill(14,48,113,76,1)
  rect(14,48,113,76,7)
  print(game_result==1 and "you win!" or "try again",44,54,10)
  print("x: restart",44,66,7)
 end
end

-- pikonest:name:1:1:24,0,16,16,52,36:537461722031
-- pikonest:name:1:2:24,0,16,16,92,60:537461722032
-- pikonest:name:1:3:24,0,16,16,60,92:537461722033
function _init()
 game_bg=3
 game_goal=1
 game_count=4
 sprite1_sx=8
 sprite1_sy=0
 sprite1_w=16
 sprite1_h=16
 sprite1_x=20
 sprite1_y=60
 sprite1_movement=1
 sprite1_speed=2
 sprite1_rule=0
 sprite1_target=0
 sprite1_on=0
 sprite1_neighbor=-1
 sprite1_visible=1
 sprite2_sx=24
 sprite2_sy=0
 sprite2_w=16
 sprite2_h=16
 sprite2_x=52
 sprite2_y=36
 sprite2_movement=0
 sprite2_speed=1
 sprite2_rule=1
 sprite2_target=0
 sprite2_on=0
 sprite2_neighbor=-1
 sprite2_visible=1
 sprite2_sfx=8
 sprite3_sx=24
 sprite3_sy=0
 sprite3_w=16
 sprite3_h=16
 sprite3_x=92
 sprite3_y=60
 sprite3_movement=0
 sprite3_speed=1
 sprite3_rule=1
 sprite3_target=0
 sprite3_on=0
 sprite3_neighbor=-1
 sprite3_visible=1
 sprite3_sfx=8
 sprite4_sx=24
 sprite4_sy=0
 sprite4_w=16
 sprite4_h=16
 sprite4_x=60
 sprite4_y=92
 sprite4_movement=0
 sprite4_speed=1
 sprite4_rule=1
 sprite4_target=0
 sprite4_on=0
 sprite4_neighbor=-1
 sprite4_visible=1
 sprite4_sfx=8
 world_width=16
 world_height=16
 world_camera=0
 world_target=-1
 world_x=0
 world_y=0
 world_tiles=1
 sfx(-1,3)
 game_win_sfx=9
 game_score=0
 game_result=0
 game_selected=0
 game_last0=btn(0)
 game_last1=btn(1)
 game_last2=btn(2)
 game_last3=btn(3)
 game_last4=btn(4)
 game_last5=btn(5)
end

function _update()
 local pressed0=btn(0) and not game_last0
 game_last0=btn(0)
 local pressed1=btn(1) and not game_last1
 game_last1=btn(1)
 local pressed2=btn(2) and not game_last2
 game_last2=btn(2)
 local pressed3=btn(3) and not game_last3
 game_last3=btn(3)
 local pressed4=btn(4) and not game_last4
 game_last4=btn(4)
 local pressed5=btn(5) and not game_last5
 game_last5=btn(5)
 if pressed5 then
  _init()
  return
 end
 if game_result~=0 then return end
 if btn(0) then sprite1_x=mid(0,sprite1_x-sprite1_speed,112) end
 if btn(1) then sprite1_x=mid(0,sprite1_x+sprite1_speed,112) end
 if btn(2) then sprite1_y=mid(0,sprite1_y-sprite1_speed,112) end
 if btn(3) then sprite1_y=mid(0,sprite1_y+sprite1_speed,112) end
 if game_result==0 and sprite2_visible==1 and sprite1_visible==1 and sprite2_x<sprite1_x+16 and sprite1_x<sprite2_x+16 and sprite2_y<sprite1_y+16 and sprite1_y<sprite2_y+16 then
  sprite2_visible=0
  game_score+=1
  sfx(sprite2_sfx,3)
 end
 if game_result==0 and sprite3_visible==1 and sprite1_visible==1 and sprite3_x<sprite1_x+16 and sprite1_x<sprite3_x+16 and sprite3_y<sprite1_y+16 and sprite1_y<sprite3_y+16 then
  sprite3_visible=0
  game_score+=1
  sfx(sprite3_sfx,3)
 end
 if game_result==0 and sprite4_visible==1 and sprite1_visible==1 and sprite4_x<sprite1_x+16 and sprite1_x<sprite4_x+16 and sprite4_y<sprite1_y+16 and sprite1_y<sprite4_y+16 then
  sprite4_visible=0
  game_score+=1
  sfx(sprite4_sfx,3)
 end
 if game_result==0 and game_score==3 then game_result=1 end
 if game_result==1 then sfx(game_win_sfx,3) end
end

function _draw()
 cls(game_bg)
 camera(world_x,world_y)
 map(0,0,0,0,world_width,world_height)
 if sprite1_visible==1 then
  sspr(8,0,16,16,sprite1_x,sprite1_y)
 end
 if sprite2_visible==1 then
  sspr(24,0,16,16,sprite2_x,sprite2_y)
 end
 if sprite3_visible==1 then
  sspr(24,0,16,16,sprite3_x,sprite3_y)
 end
 if sprite4_visible==1 then
  sspr(24,0,16,16,sprite4_x,sprite4_y)
 end
 camera()
 print("collected "..game_score.."/3",2,2,7)
 if game_result~=0 then
  rectfill(14,48,113,76,1)
  rect(14,48,113,76,7)
  print(game_result==1 and "you win!" or "try again",44,54,10)
  print("x: restart",44,66,7)
 end
end

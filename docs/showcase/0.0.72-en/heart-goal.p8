pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- a blank canvas / pikoos
function _draw()
 cls(1)
 print(x,16,16,7)
 print(phase,16,32,11)
 sspr(0,0,16,16,x,y)
 sspr(16,0,16,16,96,64)
end
function _init()
 x=24
 y=64
 phase=0
end
function _update()
 if btn(1) and (phase==0) then
  x+=1
 end
 if true and (x>=96) then
  phase=1
 end
 if btnp(5) then
  _init()
 end
end

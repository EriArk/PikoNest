pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- moon garden / pikoos
-- pikoos-speed
speed=2
-- pikoos-jump
jump=3

function _init()
 x=46 y=85 vy=0 grounded=true
 platforms={{0,101,128},{9,73,26},
  {57,62,26},{96,81,24}}
end

function _update60()
 if btn(0) then x-=speed end
 if btn(1) then x+=speed end
 x=mid(0,x,112)
 if (btnp(4) or btnp(5)) and grounded then
  vy=-(jump+1) grounded=false
 end
 local old_y=y
 vy=min(vy+0.18,4)
 y+=vy grounded=false
 for p in all(platforms) do
  if vy>=0 and old_y+16<=p[2]
   and y+16>=p[2] and x+12>p[1]
   and x+4<p[1]+p[3] then
   y=p[2]-16 vy=0 grounded=true
  end
 end
 if y>128 then x=46 y=85 vy=0 end
end

function _draw()
 cls(1)
 for i=0,29 do
  pset((i*37+13)%128,(i*17+3)%60,
   i%3==0 and 7 or 13)
 end
 circfill(104,19,8,15)
 circfill(108,16,8,1)
 for i=0,6 do
  local mx=i*24-12
  local my=48+(i%3)*8
  rectfill(mx,my,mx+24,96,13)
  rectfill(mx+8,my+14,mx+10,91,1)
 end
 rectfill(0,89,127,108,2)
 for i=0,7 do
  rectfill(i*16+3,90,i*16+9,93,3)
  rectfill(i*16+6,86,i*16+10,87,14)
 end
 for p in all(platforms) do
  local px,py,pw=p[1],p[2],p[3]
  rectfill(px,py,px+pw-1,py+8,2)
  rectfill(px,py,px+pw-1,py+2,3)
  rectfill(px+2,py,px+pw-3,py,11)
  for bx=px,px+pw-1,8 do
   rectfill(bx,py+4,bx+2,py+5,4)
  end
 end
 rectfill(109,85,118,100,4)
 rectfill(111,87,116,100,2)
 rectfill(112,88,115,89,9)
 line(68,48,68,54,10)
 line(65,51,71,51,10)
 spr(0,x,y,2,2)
end

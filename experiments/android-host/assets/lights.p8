pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- little lights / pikoos
-- light all nine cells
function toggle_cell(x,y)
 if x>=0 and x<3 and y>=0 and y<3 then
  local n=y*3+x+1
  cells[n]=not cells[n]
 end
end
function press(x,y)
 toggle_cell(x,y)
 toggle_cell(x-1,y) toggle_cell(x+1,y)
 toggle_cell(x,y-1) toggle_cell(x,y+1)
end
function _init()
 cells={} cx=1 cy=1 moves=0
 for i=1,9 do cells[i]=true end
 -- a solvable board, two moves from all lit
 press(0,0) press(2,2)
end
function _update60()
 if btnp(0) then cx=max(0,cx-1) end
 if btnp(1) then cx=min(2,cx+1) end
 if btnp(2) then cy=max(0,cy-1) end
 if btnp(3) then cy=min(2,cy+1) end
 if btnp(4) then press(cx,cy) moves+=1 end
 if btnp(5) then _init() end
end
function _draw()
 cls(1)
 print("little lights",38,9,14)
 print("light all nine",38,19,6)
 local won=true
 for y=0,2 do
  for x=0,2 do
   local lit=cells[y*3+x+1]
   if not lit then won=false end
   spr(lit and 0 or 2,29+x*24,33+y*24,2,2)
  end
 end
 rect(27+cx*24,31+cy*24,46+cx*24,50+cy*24,10)
 print(won and "all aglow!" or "moves: "..moves,42,108,won and 11 or 7)
 print("o: flip  x: reset",32,120,6)
end

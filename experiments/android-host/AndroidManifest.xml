<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="art.pikoos.runtimelab" android:versionCode="59" android:versionName="0.0.59">
    <uses-permission android:name="art.pikoos.runtimeexperiment.PROBE" />
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <queries><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent><package android:name="io.wip.pico8" /><package android:name="art.pikoos.runtimeexperiment" /></queries>
    <application android:label="PIKOOS Runtime Lab" android:debuggable="true"
        android:allowBackup="false" android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".RuntimeSetupActivity" android:exported="false" />
        <activity android:name=".LaunchActivity" android:exported="true"
            android:launchMode="singleTask" android:taskAffinity="art.pikoos.runtimelab.external"
            android:excludeFromRecents="true" />
        <provider android:name=".CartProvider"
            android:authorities="art.pikoos.runtimelab.carts"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>

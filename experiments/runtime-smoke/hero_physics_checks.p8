pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- moon garden / pikoos
-- pikoos-speed
speed=4
-- pikoos-jump
jump=3

-- pikoos-hero
hero_sx=64
hero_sy=24
hero_sw=32
hero_sh=24
hero_left=3
hero_top=3
hero_w=26
hero_h=16
-- /pikoos-hero

function _init()
 x=mid(0,flr(54-hero_w/2),128-hero_w) y=101-hero_h vy=0 grounded=true
 platforms={{0,101,128},{9,73,26},
  {57,62,26},{96,81,24}}
end

function _update60()
 if btn(0) then x-=speed end
 if btn(1) then x+=speed end
 x=mid(0,x,128-hero_w)
 if (btnp(4) or btnp(5)) and grounded then
  vy=-(jump+1) grounded=false
 end
 local old_y=y
 vy=min(vy+0.18,4)
 y+=vy grounded=false
 for p in all(platforms) do
  if vy>=0 and old_y+hero_h<=p[2]
   and y+hero_h>=p[2] and x+hero_w>p[1]
   and x<p[1]+p[3] then
   y=p[2]-hero_h vy=0 grounded=true
  end
 end
 if y>128 then x=mid(0,flr(54-hero_w/2),128-hero_w) y=101-hero_h vy=0 end
end

function _draw()
 cls(1)
 for i=0,29 do
  pset((i*37+13)%128,(i*17+3)%60,
   i%3==0 and 7 or 13)
 end
 circfill(104,19,8,15)
 circfill(108,16,8,1)
 for i=0,6 do
  local mx=i*24-12
  local my=48+(i%3)*8
  rectfill(mx,my,mx+24,96,13)
  rectfill(mx+8,my+14,mx+10,91,1)
 end
 rectfill(0,89,127,108,2)
 for i=0,7 do
  rectfill(i*16+3,90,i*16+9,93,3)
  rectfill(i*16+6,86,i*16+10,87,14)
 end
 for p in all(platforms) do
  local px,py,pw=p[1],p[2],p[3]
  rectfill(px,py,px+pw-1,py+8,2)
  rectfill(px,py,px+pw-1,py+2,3)
  rectfill(px+2,py,px+pw-3,py,11)
  for bx=px,px+pw-1,8 do
   rectfill(bx,py+4,bx+2,py+5,4)
  end
 end
 rectfill(109,85,118,100,4)
 rectfill(111,87,116,100,2)
 rectfill(112,88,115,89,9)
 line(68,48,68,54,10)
 line(65,51,71,51,10)
 sspr(hero_sx,hero_sy,hero_sw,hero_sh,x-hero_left,y-hero_top)
end

-- Diagnostic fixture only: execute the actual generated movement code.
-- Keep physical controls released while the initial checks run.
local original_init=_init
local original_draw=_draw
function _init()
 original_init()
 assert(hero_sw==32 and hero_sh==24 and hero_w==26 and hero_h==16,"binding")
 assert(x==41 and y==85,"spawn")
 _update60()
 assert(y==85 and grounded and vy==0,"floor")
 x=-10
 _update60()
 assert(x==0,"left bound")
 x=150
 _update60()
 assert(x==102,"right bound")
 x=10 y=55 vy=4 grounded=false
 _update60()
 assert(y==57 and grounded and vy==0,"platform landing")
 y=57 vy=-3 grounded=false
 _update60()
 assert(y<57 and not grounded,"up through platform")
 x=35 y=55 vy=4 grounded=false
 _update60()
 assert(y==59 and not grounded,"platform edge miss")
 y=129 vy=0
 _update60()
 assert(x==41 and y==85 and vy==0,"respawn")
 hero_h=24 x=10 y=45 vy=4 grounded=false
 _update60()
 assert(y==49 and grounded,"taller body landing")
 hero_h=16 hero_w=8 x=150 y=85 vy=0
 _update60()
 assert(x==120,"narrower body bound")
 hero_w=26
 original_init()
end
function _draw()
 original_draw()
 rect(x,y,x+hero_w-1,y+hero_h-1,10)
 rectfill(0,0,127,13,1)
 print("pikoos / 11 physics checks",5,2,11)
 print("passed in official pico-8",5,8,7)
end
